# ==========================================
# Moonshot API（用于主要的 LLM 服务）
# 申请地址：https://platform.moonshot.cn/
# ==========================================
MOONSHOT_API_KEY=sk-your-moonshot-api-key-here

# ==========================================
# SiliconFlow API（用于 embedding 模型 BAAI/bge-m3）
# 申请地址：https://siliconflow.cn/
# ==========================================
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here

# ==========================================
# 高德地图 API（用于 Navigation 子图）
# 申请地址：https://lbs.amap.com/
# ==========================================
AMAP_MAPS_API_KEY=your-amap-api-key-here

AUTH_SECRET_KEY=<run `python -c "import secrets; print(secrets.token_urlsafe(32))"` to generate>